{
  "type": "module",
  "name": "planflan3",
  "version": "1.0.0",
  "description": "1. Création de l'environnement :\r ```sh\r python -m venv env\r ```\r 2. Activer l'environnement :\r ```sh\r source env/bin/activate  # ou env\\Scripts\\activate sur Windows\r ```",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/javascript/unit",
    "test:integration": "jest tests/javascript/integration",
    "lint": "eslint app/static/js/",
    "lint:fix": "eslint app/static/js/ --fix",
    "lint:css": "stylelint app/static/css/**/*.css",
    "lint:css:fix": "stylelint app/static/css/**/*.css --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamTourte/planflan2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WilliamTourte/planflan2/issues"
  },
  "homepage": "https://github.com/WilliamTourte/planflan2#readme",
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/javascript/setupTests.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/app/static/js/$1"
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "app/static/js/**/*.js",
      "!app/static/js/**/*.test.js"
    ],
    "coverageDirectory": "coverage-js",
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.28.6",
    "@babel/plugin-transform-optional-chaining": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.25.3",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime-corejs3": "^7.25.0",
    "@googlemaps/jest-mocks": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.8",
    "babel-jest": "^29.7.0",
    "core-js": "^3.37.1",
    "eslint": "^9.39.2",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-jsdoc": "^62.3.0",
    "fetch-mock": "^12.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.3.5",
    "prettier": "^3.1.1",
    "regenerator-runtime": "^0.14.1",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "dependencies": {
    "jsdoc": "^4.0.5"
  }
}
